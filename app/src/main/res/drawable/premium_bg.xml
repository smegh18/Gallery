<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/premium_bg_start" android:endColor="@color/premium_bg_end" android:angle="0.0" />
            <corners android:radius="@dimen/_10sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#90ffffff" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/premium_line" />
            <corners android:radius="@dimen/_10sdp" />
        </shape>
    </item>
</layer-list>
