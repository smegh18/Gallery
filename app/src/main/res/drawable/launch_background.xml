<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window: same background and logo as the splash, so there's no blank screen before the first frame -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/backgroundColor" />
    <!-- Reference pre-splash icon; its logo fills the middle half, so 340dp gives the splash's 170dp logo -->
    <item android:width="340dp" android:height="340dp" android:gravity="center"
        android:drawable="@drawable/app_icon_pre_splash" />
</layer-list>
